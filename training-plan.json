  "workouts": {
    "mobility": {
      "title": "Mobility - 5–8 minutes",
      "label": "Mobility",
      "items": [
        "Quad foam rolling: 60–90 seconds per leg, gentle pressure; avoid the painful outer knee.",
        "Knee-to-wall ankle rocks: 8–10 per side; keep heel down and stop before pinching or pain.",
        "Calf stretch: 2 × 20–30 seconds per side with knee straight, then slightly bent; gentle tension only.",
        "Outward foot press: seated, press the outside of your foot into a cushion against a wall without moving the knee or ankle. 5 × 5–10 seconds per side, only if comfortable."
      ]
    },
    "a": {
      "title": "Strength A - about 25 minutes",
      "label": "Strength A",
      "items": [
        "Run first. If recovered, lift later, ideally several hours afterward. Skip if speed work leaves you exhausted.",
        "Warm up: 5 minutes of comfortable walking or cycling.",
        "Goblet squat: 2 × 8–10; comfortable depth, knees follow toes. Knees may move past toes.",
        "Dumbbell Romanian deadlift: 2 × 8–10; soft knees, hips back, weights close.",
        "Clamshell: 2 × 12–15 per side; keep hips stacked without rolling backward.",
        "Straight-knee calf raise: 2 × 10–12, both feet on flat ground; lower over 3 seconds. Use seated raises if standing reproduces soreness.",
        "Supported single-leg balance: 2 × 20–30 seconds per side; stand near support and keep pressure across the foot.",
        "Rest 60–90 seconds between strength sets; finish with 2–3 repetitions in reserve."
      ]
    },
    "b": {
      "title": "Strength B - about 20–25 minutes",
      "label": "Strength B",
      "items": [
        "Run first, then lift if recovered; separate by several hours when practical.",
        "Warm up: 5 minutes of comfortable walking or cycling.",
        "Supported split squat: 2 × 8 per side; rear foot stays on floor, hold a rack for balance.",
        "Glute bridge: 2 × 10–15; lift through hips without arching the lower back.",
        "Side-lying leg raise: 2 × 10–12 per side; top leg slightly behind you, toes facing forward.",
        "Seated bent-knee calf raise: 2 × 12–15; knees about 90°, feet on flat ground. Raise and lower slowly; add a dumbbell on the thigh only when easy.",
        "Side plank: 2 × 20–30 seconds per side; start from knees if needed.",
        "Rest 60–90 seconds between strength sets; finish with 2–3 repetitions in reserve."
      ]
    },
